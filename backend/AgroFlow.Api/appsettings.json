{
  "LocalDemo": {
    "Enabled": false
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "LogPath": "Logs/api-log.txt",
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "AgroFlowIdentity": "Data Source=(localdb)\\MSSQLLocalDB;Initial Catalog=AgroFlowIdentity;Integrated Security=True;",
    "AgroFlowDb": "Data Source=agroflow-demo.db;Default Timeout=5"

  },
  "Jwt": {
    "key": "",
    "issuer": "AgroFlow.Api",
    "audience": "AgroFlow.ApiUsers",
    "ExpiresInMinutes": 60
  }
}
