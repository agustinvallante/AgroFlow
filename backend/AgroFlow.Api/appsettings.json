{
  "LocalDemo": {
    "Enabled": false
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "LogPath": "Logs/api-log.txt",
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "AgroFlowDb": "Data Source=agroflow-demo.db;Default Timeout=5",
    "AgroFlowMvpDb": "Data Source=agroflow-mvp.db;Default Timeout=5;Foreign Keys=True"
  },
  "Jwt": {
    "key": "",
    "issuer": "AgroFlow.Api",
    "audience": "AgroFlow.ApiUsers",
    "ExpiresInMinutes": 60
  }
}
