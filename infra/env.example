# Pinned image versions
N8N_VERSION=2.37.10
EVOLUTION_VERSION=2.3.7
POSTGRES_VERSION=16-alpine
REDIS_VERSION=7-alpine

# Local loopback management ports
N8N_BIND_PORT=5678
EVOLUTION_BIND_PORT=8080

# Runtime settings
TIMEZONE=America/Argentina/Tucuman
EVOLUTION_SERVER_URL=http://localhost:8080

# AgroFlow API runs on the host during the local demo
# (dotnet run --launch-profile http --urls http://localhost:5000).
# compose.yaml maps host.docker.internal to the host gateway. On Linux the API
# must listen on a gateway-reachable address; see docs/development/local-demo.md.
AGROFLOW_API_URL=http://host.docker.internal:5000

# Evolution instance paired with the bot's WhatsApp number.
EVOLUTION_INSTANCE=agroflow-demo

# Replace every secret placeholder in infra/.env before starting containers.
# Generate N8N_ENCRYPTION_KEY and EVOLUTION_API_KEY with: openssl rand -hex 32
# Generate EVOLUTION_DB_PASSWORD with: openssl rand -hex 24
N8N_ENCRYPTION_KEY=replace-with-64-hex-characters
EVOLUTION_API_KEY=replace-with-64-hex-characters
EVOLUTION_DB_NAME=agroflow_evolution
EVOLUTION_DB_USER=agroflow_evolution
EVOLUTION_DB_PASSWORD=replace-with-48-hex-characters
