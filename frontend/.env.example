# Copiá este archivo como ".env" (o ".env.local") en la raíz del frontend.
# Vite solo expone al navegador las variables que empiezan con VITE_.

# mock → la app usa los repositorios en memoria (no necesita backend)
# http → la cola de turnos consume AgroFlow API
VITE_DATA_SOURCE=http

# Destino del proxy de Vite: el navegador llama a /api en su propio origen y
# Vite lo reenvía acá (evita CORS). Si la API quedó en otro puerto (p. ej.
# 5142 sin --urls), cambialo y reiniciá npm run dev.
# host.docker.internal es solo para n8n en Docker.
VITE_API_URL=http://localhost:5000
