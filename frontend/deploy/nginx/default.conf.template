# Dashboard server for the VPS demo. Rendered by the nginx image entrypoint
# (envsubst, filtered to AGROFLOW_* variables). It mirrors the rules of the
# local Vite proxy (server/dashboardProxy.ts):
#   - the dashboard key is added server side, never sent to the browser;
#   - n8n channel routes are never reachable from the browser;
#   - client-supplied AgroFlow key headers are always dropped.
# The whole site sits behind HTTP basic auth (10-basic-auth.sh) because the
# LocalDemo appointment routes are anonymous.
server {
    listen 80;
    server_name _;
    root /usr/share/nginx/html;

    auth_basic "ZafraFlow";
    auth_basic_user_file /etc/nginx/htpasswd;

    resolver 127.0.0.11 valid=10s;
    set $agroflow_api http://agroflow_api:8080;

    # Same guard as the Vite proxy: no escape sequences in the path.
    if ($request_uri ~* "^[^?]*(\.\.|%2e|%2f|%5c|\x5c)") {
        return 400;
    }

    # n8n-only routes: the browser never reaches them.
    location ^~ /api/v1/conversation-events { return 404; }
    location ^~ /api/v1/conversation-reply-intents { return 404; }

    # Dashboard routes that receive the key (collections and subroutes).
    location ~ ^/api/v1/(conversations|drivers|associations)(/|$) {
        include /etc/nginx/snippets/agroflow-proxy.inc;
        proxy_set_header X-AgroFlow-Dashboard-Key "${AGROFLOW_DASHBOARD_KEY}";
    }

    # Read-only catalogs: GET on the collection only.
    location ~ ^/api/v1/(windows|trucks|farms)$ {
        limit_except GET { deny all; }
        include /etc/nginx/snippets/agroflow-proxy.inc;
        proxy_set_header X-AgroFlow-Dashboard-Key "${AGROFLOW_DASHBOARD_KEY}";
    }

    # Everything else under /api (appointments, etc.) goes without the key.
    location /api/ {
        include /etc/nginx/snippets/agroflow-proxy.inc;
        proxy_set_header X-AgroFlow-Dashboard-Key "";
    }

    location = /health {
        include /etc/nginx/snippets/agroflow-proxy.inc;
        proxy_set_header X-AgroFlow-Dashboard-Key "";
    }

    location /assets/ {
        expires 7d;
        try_files $uri =404;
    }

    # Single-page app: unknown paths serve index.html.
    location / {
        add_header Cache-Control "no-cache";
        try_files $uri $uri/ /index.html;
    }
}
